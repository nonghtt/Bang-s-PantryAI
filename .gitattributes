# 저장소 안에서는 항상 LF로 정규화한다.
# (Windows 작업 트리에서는 core.autocrlf 설정에 따라 CRLF로 체크아웃될 수 있음)
* text=auto eol=lf

# 셸 스크립트는 작업 트리에서도 반드시 LF
*.sh text eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리 — 변환 금지
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
